{
  "name": "gitea-cross-repository-issue-portal",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @gitea-portal/api --filter @gitea-portal/web dev",
    "storybook": "pnpm --filter @gitea-portal/web storybook",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test:api": "pnpm --filter @gitea-portal/api test",
    "test:web": "pnpm --filter @gitea-portal/api exec tsx --test ../web/test/*.test.ts",
    "test:e2e": "pnpm --filter @gitea-portal/web test:e2e",
    "test": "pnpm test:api && pnpm test:web && pnpm test:e2e",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  }
}
